PORT=3001
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_DATABASE=your_db_name

JWT_SECRET=replace_with_a_strong_secret

# Online payments. Leave PAYMENTS_PROVIDER empty to keep payments off (checkout only creates an unpaid invoice).
# Values: mock (local testing only, refused when NODE_ENV=production) | square
PAYMENTS_PROVIDER=
# Public URL of the storefront, used for payment redirects (defaults to the first CORS_ORIGIN)
CLIENT_URL=
# Square (PAYMENTS_PROVIDER=square).
# Locally, and anywhere NODE_ENV is not "production", only the sandbox is ever used and
# SQUARE_ENVIRONMENT=production is refused. Live payments need NODE_ENV=production,
# SQUARE_ENVIRONMENT=production and the SQUARE_PRODUCTION_* values below.
SQUARE_ENVIRONMENT=sandbox
SQUARE_SANDBOX_ACCESS_TOKEN=
SQUARE_SANDBOX_LOCATION_ID=
SQUARE_SANDBOX_WEBHOOK_SIGNATURE_KEY=
# Production values: set these on the NAS only, never in a local .env
SQUARE_PRODUCTION_ACCESS_TOKEN=
SQUARE_PRODUCTION_LOCATION_ID=
SQUARE_PRODUCTION_WEBHOOK_SIGNATURE_KEY=
# Must match the webhook subscription URL exactly, as Square signs it
SQUARE_WEBHOOK_URL=https://api.craftykeepsakes.uk/api/v2/payments/webhook
