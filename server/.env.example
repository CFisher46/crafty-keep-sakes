PORT=3001
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_DATABASE=your_db_name

JWT_SECRET=replace_with_a_strong_secret

# Email verification (Resend). Keep API keys on the backend only.
RESEND_API_KEY=
# Separate senders for verification and contact enquiries.
RESEND_VERIFICATION_FROM_EMAIL=Email Verification <verify@craftykeepsakes.uk>
# Legacy verification sender; used only when RESEND_VERIFICATION_FROM_EMAIL is unset.
RESEND_FROM_EMAIL=
# Optional verified Resend sender for contact enquiries; defaults to enquires@craftykeepsakes.uk.
RESEND_CONTACT_FROM_EMAIL=
FRONTEND_URL=http://localhost:3000
# Optional comma-separated trusted browser origins for verification links.
# For a shared backend, list the dev and production frontend origins.
VERIFICATION_FRONTEND_ORIGINS=http://localhost:3000

# Online payments. Leave PAYMENTS_PROVIDER empty to keep payments off (checkout only creates an unpaid invoice).
# Values: mock (local testing only, refused when NODE_ENV=production) | square
PAYMENTS_PROVIDER=
# Public URL of the storefront, used for payment redirects (defaults to the first CORS_ORIGIN)
CLIENT_URL=
# Square (PAYMENTS_PROVIDER=square).
# Locally, and anywhere NODE_ENV is not "production", only the sandbox is ever used and
# SQUARE_ENVIRONMENT=production is refused. Live payments need NODE_ENV=production,
# SQUARE_ENVIRONMENT=production and the SQUARE_PRODUCTION_* values below.
SQUARE_ENVIRONMENT=sandbox
SQUARE_SANDBOX_ACCESS_TOKEN=
SQUARE_SANDBOX_LOCATION_ID=
SQUARE_SANDBOX_WEBHOOK_SIGNATURE_KEY=
# Production values: set these on the NAS only, never in a local .env
SQUARE_PRODUCTION_ACCESS_TOKEN=
SQUARE_PRODUCTION_LOCATION_ID=
SQUARE_PRODUCTION_WEBHOOK_SIGNATURE_KEY=
# Must match the webhook subscription URL exactly, as Square signs it
SQUARE_WEBHOOK_URL=https://api.craftykeepsakes.uk/api/v2/payments/webhook

# Image storage (MinIO / S3). Leave unset to keep writing images to the local disk.
# MINIO_PUBLIC_URL is required to turn it on: the stored image value is a full URL on this base.
# Locally the private endpoint does not resolve; set MINIO_ENDPOINT to a public proxy/URL instead.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_PRIVATE_ENDPOINT=
MINIO_ENDPOINT=
MINIO_BUCKET=images
MINIO_PUBLIC_URL=

# Locks the API to Cloudflare. Leave empty to disable. When set, requests need an X-Origin-Secret header
# with this value (except /health and the Square webhook). Use 32+ random characters.
ORIGIN_SECRET=
