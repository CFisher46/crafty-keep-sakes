# Local server -> Railway services. Copy to .env.railway (gitignored) and run: npm run dev:railway
# Values here override .env. Use the MySQL TCP proxy host and port, not the internal address.
DB_HOST=your-proxy-host.proxy.rlwy.net
DB_PORT=00000
DB_USER=root
DB_PASSWORD=
DB_DATABASE=railway

MINIO_ENDPOINT=https://your-bucket.up.railway.app
MINIO_BUCKET=images
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_PUBLIC_URL=https://your-bucket.up.railway.app/images
