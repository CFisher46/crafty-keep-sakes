PORT=3001
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_DATABASE=your_db_name

# Must be 64 hex chars (32 bytes) for AES-256-CBC
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Optional: previous key used to decrypt older records after key rotation
ENCRYPTION_KEY_PREVIOUS=

JWT_SECRET=replace_with_a_strong_secret

# Domain-level API routing source flags for Stage 2 switchboard.
# Values: legacy | v2
AUTH_API_SOURCE=legacy
PRODUCTS_API_SOURCE=legacy
USERS_API_SOURCE=legacy
AUDIT_API_SOURCE=legacy
