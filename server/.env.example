PORT=3001
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_DATABASE=your_db_name

# Must be 64 hex chars (32 bytes) for AES-256-CBC
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Optional: previous key used to decrypt older records after key rotation
ENCRYPTION_KEY_PREVIOUS=

JWT_SECRET=replace_with_a_strong_secret

# Domain-level API routing source flags for Stage 2 switchboard.
# Values: legacy | v2
AUTH_API_SOURCE=legacy
PRODUCTS_API_SOURCE=legacy
USERS_API_SOURCE=legacy
AUDIT_API_SOURCE=legacy

# Online payments. Leave PAYMENTS_PROVIDER empty to keep payments off (checkout only creates an unpaid invoice).
# Values: mock (local testing only, refused when NODE_ENV=production) | square (not built yet)
PAYMENTS_PROVIDER=
# Public URL of the storefront, used for payment redirects (defaults to the first CORS_ORIGIN)
CLIENT_URL=
# Reserved for the Square provider; keep real values out of source control
# SQUARE_ENVIRONMENT=sandbox
# SQUARE_ACCESS_TOKEN=
# SQUARE_LOCATION_ID=
# SQUARE_WEBHOOK_SIGNATURE_KEY=
# SQUARE_WEBHOOK_URL=https://api.craftykeepsakes.uk/api/v2/payments/webhook
